rename(Vocalisation = X00000001,
ST = ST,
StartTime = X00.00.10.720,
DUR = DUR,
Duration = X00.00.02.030,
Type = X.OK.,
Transcription = ðəðɛdədadə)
rest_data <- as_tibble(read.delim('/Volumes/Seagate/301025_Desktop/CSVFiles/ProcDXBs140416.txt', skip = 1, sep = " ")) %>%
rename(Vocalisation = X00000001,
ST = ST,
StartTime = X00.00.10.720,
DUR = DUR,
Duration = X00.00.02.030,
Type = X.OK.,
Transcription = ðəðɛdədadə)
VocalisationData <- rbind(toptopline_data, topline_data, rest_data) %>%
mutate(SplitVar = ifelse(startsWith(Vocalisation, "["), "Split", "NoSplit")) %>%
mutate(Heading = ifelse(startsWith(Vocalisation, "["), Vocalisation, NA)) %>%
tidyr::fill(Heading) %>%
filter(SplitVar != "Split") %>%
mutate(Duration = as.numeric(sapply(strsplit(Duration, ":"), `[`,3))) %>%
mutate(ChildID = sapply(strsplit(Heading, "\\\\"), `[`,8)) %>%
mutate(SessionID = sapply(strsplit(Heading, "\\\\"), `[`,9)) %>%
mutate(SessionID = str_sub(SessionID, 4, 6)) %>%
mutate(SessionID_Name = paste0('Session ', as.numeric(str_sub(SessionID, 2, 3)))) %>%
mutate(SessionID_Name = as.factor(SessionID_Name)) %>%
mutate(SessionID_Name = fct_relevel(SessionID_Name,
"Session 1", "Session 2", "Session 3",
"Session 4", "Session 5", "Session 6",
"Session 7", "Session 8", "Session 9",
"Session 10", "Session 11", "Session 12",
"Session 13", "Session 14", "Session 15",
"Session 16", "Session 17", "Session 18",
"Session 19", "Session 20", "Session 21",
"Session 22", "Session 23", "Session 24",
"Session 25", "Session 26", "Session 27")) %>%
mutate(StartTime = as.numeric(sapply(strsplit(StartTime, ":"), `[`,3)) +
(as.numeric(sapply(strsplit(StartTime, ":"), `[`,2)) * 60)) %>%
mutate(EndTime = StartTime + Duration) %>%
mutate(Vocalisation = as.numeric(Vocalisation)) %>%
mutate(SessionID_Num = as.numeric(str_sub(SessionID, 2, 3))) %>%
mutate(ChildIDNum = as.numeric(str_sub(ChildID, 2, 3))) %>%
mutate(StartTime_min = StartTime/60) %>%
mutate(EndTime_min = EndTime/60)
