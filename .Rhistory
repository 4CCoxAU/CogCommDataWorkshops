# Want-rate per 100 utterances, for each child AND their mother.
want_rates <- manchester %>%
mutate(has_want = str_detect(utterance, "\\b(want|wanna)\\b")) %>%
group_by(child, speaker) %>%
summarise(per_100 = 100 * mean(has_want), .groups = "drop")
# Side-by-side bars: each family, child next to mother.
ggplot(want_rates, aes(x = child, y = per_100, fill = speaker)) +
geom_col(position = "dodge") +
labs(title = "WANT runs in families",
y = "want-utterances per 100", fill = "")
# Want-rate per 100 utterances, for each child AND their mother.
want_rates <- manchester %>%
filter(speaker %in% c("CHI", "MOT")) %>%
mutate(has_want = str_detect(utterance, "\\b(want|wanna)\\b")) %>%
group_by(child, speaker) %>%
summarise(per_100 = 100 * mean(has_want), .groups = "drop")
# Side-by-side bars: each family, child next to mother.
ggplot(want_rates, aes(x = child, y = per_100, fill = speaker)) +
geom_col(position = "dodge") +
labs(title = "WANT runs in families",
y = "want-utterances per 100", fill = "")
# Island structure per child: of their wants, what share carry a subject? A negation?
island_structure <- manchester %>%
filter(speaker == "CHI") %>%
mutate(has_want = str_detect(utterance, "\\b(want|wanna)\\b")) %>%
filter(has_want) %>%
mutate(with_subject  = str_detect(utterance, "\\bI (want|wanna)\\b"),
with_negation = str_detect(utterance, "\\b(don't|doesn't) (want|wanna)\\b")) %>%
group_by(child) %>%
summarise(subject_share  = 100 * mean(with_subject),
negation_share = 100 * mean(with_negation),
n_wants = n())
# Each child is one point in island-development space.
ggplot(island_structure,
aes(x = subject_share, y = negation_share, label = child)) +
geom_point() +
geom_text(vjust = -0.7) +
labs(title = "Twelve WANT islands",
x = "% of wants with a subject (I want)",
y = "% of wants negated (don't want)")
# Each child is one point in island-development space.
ggplot(island_structure,
aes(x = subject_share, y = child, label = child)) +
geom_point() +
geom_text(vjust = -0.7) +
labs(title = "Twelve WANT islands",
x = "% of wants with a subject (I want)",
y = "% of wants negated (don't want)")
# Of each child's wants, per month: what share carry the subject?
iwant_growth <- manchester %>%
filter(speaker == "CHI") %>%
mutate(has_want = str_detect(utterance, "\\b(want|wanna)\\b")) %>%
filter(has_want) %>%
mutate(with_subject = str_detect(utterance, "\\bI (want|wanna)\\b")) %>%
group_by(child, age_months) %>%
summarise(subject_share = 100 * mean(with_subject),
n_wants = n(),
.groups = "drop")
# Twelve islands growing a subject — Anne in red, as always.
ggplot(iwant_growth, aes(x = age_months, y = subject_share, group = child)) +
geom_line(colour = "grey70") +
geom_line(data = iwant_growth %>% filter(child == "Anne"),
colour = "firebrick", linewidth = 1.2) +
labs(title = "The WANT island grows a subject",
x = "age (months)", y = "% of wants with 'I'")
ggplot(iwant_growth, aes(x = age_months, y = subject_share)) +
geom_line(colour = "grey50") +
geom_point(aes(size = n_wants), alpha = .4) +
facet_wrap(~child) +
labs(title = "Twelve islands grow a subject — one child per panel",
x = "age (months)", y = "% of wants with 'I'",
size = "wants that month")
ggplot(iwant_growth, aes(x = age_months, y = subject_share)) +
geom_line(colour = "grey50") +
geom_point(aes(size = n_wants), alpha = .4) +
facet_wrap(~child) +
labs(title = "Twelve islands grow a subject, one child per panel",
x = "age (months)", y = "% of wants with 'I'",
size = "wants that month") +
theme_bw()
